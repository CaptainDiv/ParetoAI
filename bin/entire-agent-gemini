#!/usr/bin/env python3
# entire-agent-gemini: Entire Agent Integration Protocol shim for Gemini CLI.
# Add this bin/ directory to $PATH, then run `entire agent add gemini`.
# See pareto_ai/entire_agent_gemini.py (ADR-0004) for what this implements.
import os
import runpy
import sys

_here = os.path.dirname(os.path.abspath(__file__))
sys.argv = ["entire-agent-gemini", *sys.argv[1:]]
runpy.run_path(os.path.join(_here, "..", "pareto_ai", "entire_agent_gemini.py"), run_name="__main__")
